function carouselInit() {
  const FETCH_TIMEOUT = 20000;
  const glideEl = fragmentElement.querySelector('.glide');
  const glideInstance = new Glide(glideEl, {
    type: 'slider',
    bound: true,
    perView: 4,
    gap: 0,
    breakpoints: {
      768: { perView: 1 },
      996: { perView: 3 }
    }
  });

  orderCarouselItems();
  
  const promises = fetchCarouselData();
  
  const timeoutId = setTimeout(() => {
    const euki = document.querySelector('.euki');
    if (euki) euki.style.display = 'none';
  }, FETCH_TIMEOUT);

  Promise.allSettled(promises).then(results => {
    const euki = document.querySelector('.euki');
    if (!euki || euki.style.display === 'none') return;

    clearTimeout(timeoutId);
    
    const loadingIndicator = document.getElementById('euki-loading');
    if (loadingIndicator) {
      loadingIndicator.classList.add('ecl-u-d-none');
    }

    const errorCount = results.filter(r => r.status === 'rejected').length;
    
    if (errorCount > 3) {
      euki.style.display = 'none';
    } else {
      glideEl.classList.remove('ecl-u-d-none');
      glideInstance.mount();

      if (configuration.autoMove) {
        glideInstance.play(3000);
      }
    }
  });
}

/**
  * API endpoints documentation:
  * 1. The `geo` parameter is mandatory for the script to work. 
  *    Without it, the API returns data for all available countries/entities combined, which breaks
  *    our logic of using the last object entry to get the latest time & value.
  *    - geo=EU should be used for all inflation rate (inflation, energy inflation, food inflation) 
  *    - geo=EU27_2020 should be used for the rest of the EU key indicators
  * 2. Redundant parameters (default on all endpoints): 
  *    - format=JSON
  *    - lang=EN
  */
function fetchCarouselData() {
  const promises = [];
  const eukiGeoEU27 = '&geo=EU27_2020';
  const eukiGeoEU = '&geo=EU';

  // EUKI: Government deficit
  if (!configuration.hideEukiGovernmentDeficit) {
    promises.push(fetchAndUpdateCarouselItem(`gov_10dd_edpt1?freq=A&unit=PC_GDP&na_item=B9&sector=S13${eukiGeoEU27}`, '#government-deficit'));
  }

  // EUKI: Government debt
  if (!configuration.hideEukiGovernmentDebt) {
    promises.push(fetchAndUpdateCarouselItem(`gov_10dd_edpt1?freq=A&unit=PC_GDP&na_item=GD&sector=S13${eukiGeoEU27}`, '#government-debt'));
  }

  // EUKI: Inflation Rate
  if (!configuration.hideEukiInflationRate) {
    promises.push(fetchAndUpdateCarouselItem(`prc_hicp_minr?unit=RCH_A&coicop18=TOTAL${eukiGeoEU}`, '#inflation-rate'));
  }

  // EUKI: GDP Growth
  if (!configuration.hideEukiGDPGrowth) {
    promises.push(fetchAndUpdateCarouselItem(`namq_10_gdp?na_item=B1GQ&unit=CLV_PCH_PRE&s_adj=SCA${eukiGeoEU27}`, '#gdp-growth'));
  }

  // EUKI: Unemployment rate
  if (!configuration.hideEukiUnemploymentRate) {
    promises.push(fetchAndUpdateCarouselItem(`une_rt_m?sex=T&unit=PC_ACT&s_adj=SA&age=TOTAL${eukiGeoEU27}`, '#unemployment'));
  }

  // EUKI: Housing prices
  if (!configuration.hideEukiHousingPrices) {
    promises.push(fetchAndUpdateCarouselItem(`prc_hpi_q?purchase=TOTAL&unit=RCH_A${eukiGeoEU27}`, '#housing-prices'));
  }

  // EUKI: Population
  if (!configuration.hideEukiPopulation) {
    promises.push(fetchAndUpdateCarouselItem(`demo_gind?indic_de=JAN${eukiGeoEU27}`, '#population', true));
  }

  // EUKI: Energy inflation rate
  if (!configuration.hideEukiEnergyInflationRate) {
    promises.push(fetchAndUpdateCarouselItem(`prc_hicp_minr?unit=RCH_A&coicop18=NRG${eukiGeoEU}`, '#energy-inflation'));
  }

  // EUKI: Food inflation rate
  if (!configuration.hideEukiFoodInflationRate) {
    promises.push(fetchAndUpdateCarouselItem(`prc_hicp_minr?unit=RCH_A&coicop18=CP011${eukiGeoEU}`, '#food-inflation'));
  }

  return promises;
}

// Helper function to fetch data and update the carousel UI
function fetchAndUpdateCarouselItem(serviceUrl, cssSelector, isPopulation = false) {
  const euki = document.querySelector('.euki');
  const url = 'https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/' + serviceUrl;

  return fetch(url)
    .then(response => {
      if (!response.ok) throw new Error('Network response was not ok');
      return response.json();
    })
    .then(data => {
      const latestKeyValue = Object.entries(data.value).pop();
      const timeCategoryIndex = data.dimension.time.category.index;
      const timePeriod = Object.keys(timeCategoryIndex).find(key => timeCategoryIndex[key] == latestKeyValue[0]);
      
      euki.querySelector(`${cssSelector}-period`).innerHTML = timePeriod;
      
      if (isPopulation) {
        euki.querySelector(`${cssSelector}-value`).innerHTML = latestKeyValue[1].toString().match(/.{1,3}/g).join(' ');
      } else {
        euki.querySelector(`${cssSelector}-value`).innerHTML = latestKeyValue[1].toFixed(1);
      }
    })
    .catch(error => {
      const item = euki.querySelector(cssSelector);
      if (item) item.style.display = "none";
      throw error;
    });
}

function orderCarouselItems() {
  const carousel = fragmentElement.querySelectorAll('.glide__slide');
  const orderArr = configuration.orderBoxes.split(',');
  // if order array is smaller, make them equal in length
  if (orderArr.length < carousel.length) {
    for (let i = orderArr.length; i < carousel.length; i++) {
      orderArr.push((i+1).toString());
    }
  }
  if (configuration.autoOrder) {
    for (let i = orderArr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [orderArr[i], orderArr[j]] = [orderArr[j], orderArr[i]];
    }
  }
  // apply order to carousel
  for (let i = 0; i < carousel.length; i++) {
    carousel[i].style.order = orderArr[i].toString();
  }
