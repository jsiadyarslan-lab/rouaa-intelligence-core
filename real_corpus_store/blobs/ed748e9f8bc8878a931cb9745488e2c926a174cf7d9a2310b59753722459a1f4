<div class="node--blog container">
  <div class="row row--relative">
        
    <article data-history-node-id="171386" about="/news/blogs/managing-conflicts-interest-insurance" class="node--type-blog col-xs-10">
                    <div class="blog__image">
          						
  						    <picture>
                  <source srcset="/sites/default/files/styles/blog_main_image_desktop/public/media/images/vertically-integrated-insurance-blog.jpg.webp?itok=2ZOp2-s1 1x" media="all and (min-width: 992px)" type="image/webp" width="945" height="575"/>
