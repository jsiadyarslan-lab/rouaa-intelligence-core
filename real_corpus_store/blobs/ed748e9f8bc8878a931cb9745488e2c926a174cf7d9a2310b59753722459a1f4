        <h1 class="heading__underline fca-underlined--ff585d">
          
<span>Managing conflicts of interest in insurance</span>

        </h1>
        
        <div class="blog__author">
          <div class="blog__author__image">
            
  						  
<img loading="lazy" src="/sites/default/files/styles/thumbnail/public/media/images/chris-knight-blog.jpg.webp?itok=OEOuVvD_" width="100" height="100" alt="Chris Knight" typeof="foaf:Image" class="img-responsive" />



			

