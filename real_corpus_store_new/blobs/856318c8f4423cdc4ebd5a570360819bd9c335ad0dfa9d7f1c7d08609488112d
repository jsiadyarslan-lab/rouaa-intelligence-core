<script>

var qs=getUrlVars();

var s_category = "";
var s_year     = "";
var s_month    = "";
var s_day      = "";
var s_number   = 20;
var cnt        = 0;
var index      = 1;

var category_list = [];


$(function() {

  // 絞り込みをクリア
  $("#clear-btn").click(function(){
    $(".JPX-sidecontents-search-wrapper select").val("");
  });
  
  $("#submit-btn").click(function(){
    
    s_category = $("select[name='category']").val();
    s_year     = $("select[name='year']").val();
    s_month    = $("select[name='month']").val();
    s_day      = $("select[name='day']").val();
    
    location.href = '/corporate/news/news-releases/index.html?category='+s_category+'&year='+s_year+'&month='+s_month+'&day='+s_day+'&number='+s_number;
    return false;
  });

    
  $(".pages select.number").change(function(){
    s_category = $("select[name='category']").val();
    s_year     = $("select[name='year']").val();
    s_month    = $("select[name='month']").val();
    s_day      = $("select[name='day']").val();
    s_number   = $(this).val();

    location.href = '/corporate/news/news-releases/index.html?category='+s_category+'&year='+s_year+'&month='+s_month+'&day='+s_day+'&number='+s_number;
    return false;
  });


  $(document).ready(function(){
    
    var ret_category_list=getCategoryList('JPXからのお知らせ');
    for(var key in ret_category_list)
    {
      category_list[key]=ret_category_list[key];
    }
    
    var category_html='';
    for (var i in category_list)
    {
      category_html += '<option value="'+i+'">'+category_list[i]+'</option>';
    }
    $('#category').append(category_html);
    
    if( ("category" in qs) ){
      s_category=qs["category"];
    }
    if( ("year" in qs) ){
      s_year=qs["year"];
    }
    if( ("month" in qs) ){
      s_month=qs["month"];
    }
    if( ("day" in qs) ){
      s_day=qs["day"];
    }
    if( ("number" in qs) ){
      s_number=qs["number"];
    }
    if( ("index" in qs) ){
      index=parseInt(qs["index"],10);
    }
    
    cnt = 0;
    
    
    var disp_length=jsonLoad();
    
    
    

    var search_type='';
    var all_category='';
    if(s_category.match(/^ca[0-9]*$/) != null) { search_type='category'; }
    else if(s_category.match(/^co[0-9]*$/) != null) { search_type='corporation'; }
    else if(s_category.match(/^ir[0-9]*$/) != null) { search_type='ir_category'; }
    else if(s_category.match(/^ki[0-9]*$/) != null) { search_type='kind'; }
    else
    {
      
      search_type='kind';
      all_category='JPXからのお知らせ';
      
      
      s_category='';
    }
    
    var page_kind='corporate';
    
    
    var news_search_length=getNewsSearchLength(page_kind, search_type, ( all_category!='' ? all_category : category_list[s_category] ),s_year,s_month,s_day);
    if(all_category=='マーケットニュース')
    {
      news_search_length+=getNewsSearchLength(page_kind, search_type, 'JPXからのお知らせ',s_year,s_month,s_day);
    }
    
    if(disp_length>0)
    {
      var count_text= ((index-1)*s_number+1)+'～'+((((index-1)*s_number+1)+disp_length)-1)+'件を表示 / '+news_search_length+'件中';
      $('#news-count-text').append(count_text);
    }
    else
    {
      var count_text= (0)+'～'+(0)+'件を表示 / '+news_search_length+'件中';
      $('#news-count-text').append(count_text);
    }
    
    var condition_text='';
    condition_text += 'カテゴリー / 表示期間： ';
    condition_text += s_category=='' ? '<span>全て</span> / '     : '<span>'+category_list[s_category]+'</span> / ';
    condition_text += (s_year==''    ? '****' : s_year ) + '年' ;
    condition_text += (s_month==''   ? '**'   : s_month) + '月' ;
    condition_text += (s_day==''     ? '**'   : s_day  ) + '日' ;
    $('#news-count-select').append(condition_text);
    
    
    
    var navi='';
    if(news_search_length==0){
      navi+='<li class="news-prev-none"></li>';
    }else if(index>1){
      var prev_index=parseInt(index,10)-1;
      navi+='<li><a class="JPX-btn-prev" href="?category='+s_category+'&year='+s_year+'&month='+s_month+'&day='+s_day+'&number='+s_number+'&index='+prev_index+'">prevArrow</a></li>';
    }else{
      navi+='<li><a class="JPX-btn-prev -is-active" href="#">prevArrow</a></li>';
    }
    
    var start_index = index<=5 ? 1 : index-5 ;
    var end_index=start_index+9;
    
    final_index=Math.ceil(news_search_length/s_number);
    if( end_index > final_index )
    {
      end_index=final_index;
      start_index=end_index-9;
      if(start_index<=0)
      {
        start_index=1;
      }
    }
    
    for(var i=start_index;i<=end_index;i++)
    {
      if(index==i)
      {
        navi+='<li><span>'+i+'</span></li>';
      }
      else
      {
        navi+='<li><a href="?category='+s_category+'&year='+s_year+'&month='+s_month+'&day='+s_day+'&number='+s_number+'&index='+i+'">'+i+'</a></li>';
      }
    }
    
    
    if(news_search_length==0){
      navi+='<li class="news-next-none" id="news-next1"></li>';
    }else if( index*s_number < news_search_length ){
      var next_index=parseInt(index,10)+1;
      navi+='<li><a class="JPX-btn-next" href="?category='+s_category+'&year='+s_year+'&month='+s_month+'&day='+s_day+'&number='+s_number+'&index='+next_index+'">nextArrow</a></li>';
    }else{
      navi+='<li><a class="JPX-btn-next -is-active" href="#">nextArrow</a></li>';
    }
    
    $("#news-paging").children("ul").append(navi);
    $("#news-paging-solo").children("ul").append(navi);
    
    
    $("select[name='category']").val(s_category);
    $("select[name='year']").val(s_year);
    $("select[name='month']").val(s_month);
    $("select[name='day']").val(s_day);
    $("select[name='results']").val(s_number);
  });
});

function jsonLoad()
{
  
  var category_search_word    = s_category.match(/^ca[0-9]*$/) == null ? '' : category_list[s_category] ;
  var corporation_search_word = s_category.match(/^co[0-9]*$/) == null ? '' : category_list[s_category] ;
  var ir_category_search_word = s_category.match(/^ir[0-9]*$/) == null ? '' : category_list[s_category] ;
  var kind_search_word        = s_category.match(/^ki[0-9]*$/) == null ? '' : category_list[s_category] ;
  
  kind_search_word='JPXからのお知らせ';
  
  var news_info=[];
  news_info=getNewsInfo(s_number*(index-1)+1, s_number, kind_search_word, category_search_word, corporation_search_word, ir_category_search_word, s_year, s_month, s_day);
  //console.log('call getNewsInfo=['+(s_number*(index-1)+1)+','+s_number+','+kind_search_word+','+category_search_word+','+corporation_search_word+','+ir_category_search_word+','+s_year+','+s_month+','+s_day+']');
  
  if(news_info.length>0)
  {
    var disp_html='';
    
    
        disp_html=getNewsTagList_renewal(news_info, true, true, -1, true, false);
      
    
    $("div.JPX-news-list").children("ul").append(disp_html);
  }
  else
  {
    $("div.JPX-news-list").append('<div><p class="component-text">現在、該当する情報はありません。</p></div>');
  }
  
  return news_info.length;
}



function getUrlVars()
{
  var vars = [], hash;
  var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
  for(var i = 0; i < hashes.length; i++) {
    hash = hashes[i].split('=');
    vars.push(hash[0]);
    vars[hash[0]] = hash[1];
  }
  return vars;
}

