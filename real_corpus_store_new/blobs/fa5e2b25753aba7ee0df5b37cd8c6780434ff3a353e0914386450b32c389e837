    <section aria-label="Notice" class="govuk-notification-banner gem-c-notice govuk-!-margin-bottom-8" role="region" dir="ltr" title="This was published under the <span lang=&quot;en&quot; dir=&quot;ltr&quot;>2024 to 2026 Starmer Labour government</span>">
