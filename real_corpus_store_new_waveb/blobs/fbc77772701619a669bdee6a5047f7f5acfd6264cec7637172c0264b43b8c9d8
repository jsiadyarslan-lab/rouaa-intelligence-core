  // Get the active tab label (e.g., "Upcoming Releases", "2025 Schedule", etc.)
  const activeTab = document.querySelector("ul.tabs--primary li.active a")?.textContent.trim();
  if (!activeTab) {
    console.warn("No active tab detected. Skipping updates.");
    return;
  }

  const table = document.querySelector("#release-schedule-table");
  if (!table) {
    console.error("Table with ID #release-schedule-table not found.");
    return;
  }

  let changesMade = 0;

  // Step 1: Pre-index all matching cells by date BEFORE any updates
  const dateIndexMap = {};
  const cells = Array.from(table.querySelectorAll("td.scheduled-date"));

  cells.forEach(cell => {
    const releaseDateDiv = cell.querySelector(".release-date");
    if (!releaseDateDiv) return;

    const rawDate = Array.from(releaseDateDiv.childNodes)
      .filter(node => node.nodeType === Node.TEXT_NODE)
      .map(node => node.textContent.trim())
      .join(" ");

    if (!dateIndexMap[rawDate]) {
      dateIndexMap[rawDate] = [];
    }
    dateIndexMap[rawDate].push(cell);
  });

  // Step 2: Apply updates using pre-indexed cells
  updates.forEach(update => {
    const appliesTo = update["apply-to"];

    // Skip update if it doesn't apply to the current tab
    if (appliesTo !== null && Array.isArray(appliesTo) && !appliesTo.includes(activeTab)) {
      console.debug(`Skipping update for "${update["target-date"]}" — not applicable to tab "${activeTab}"`);
      return;
    }

    const matchingCells = dateIndexMap[update["target-date"]];
    if (!matchingCells || !matchingCells[update.occurrenceIndex]) {
      console.warn(`No matching cell found for date "${update["target-date"]}" at index ${update.occurrenceIndex}`);
      return;
    }

    const targetCell = matchingCells[update.occurrenceIndex];
    const releaseDateDiv = targetCell.querySelector(".release-date");
    const smallTag = targetCell.querySelector("small");
    const row = targetCell.closest("tr");
    let modified = false;

    // Insert topText if provided
    if (update["replacement-topText"]) {
      const span = document.createElement("span");
      span.textContent = update["replacement-topText"] + " ";
      releaseDateDiv.prepend(span);

      // Add highlight class to the <td>
      targetCell.classList.add("bea-highlight");
      modified = true;
    }

    // Replace release-date text if provided
    if (update["replacement-releaseText"]) {
      releaseDateDiv.textContent = update["replacement-releaseText"];
      modified = true;
    }

    // Replace small text if provided
    if (update["replacement-smallText"] && smallTag) {
      const originalDate = update["target-date"];
      const [month, day] = originalDate.split(" ");
      const formatted = `(Orig. ${monthMap[month]} ${day})`;
      smallTag.textContent = isNaN(Date.parse(update["replacement-smallText"]))
        ? update["replacement-smallText"]
        : formatted;
      modified = true;
    }

    // Apply row-disable class if requested
    if (update["row-disable"] && row) {
      row.classList.add("row-disabled");
      modified = true;
    }

    if (modified) {
      console.debug("Updated row:", {
        targetDate: update["target-date"],
        occurrenceIndex: update.occurrenceIndex,
        activeTab,
        rowClass: row?.className,
        cellHTML: targetCell.innerHTML
      });
      changesMade++;
    }
  });

  // Final step: make the table visible
  table.style.visibility = "visible";

  if (changesMade > 0) {
    console.info(`${changesMade} row(s) updated and table made visible.`);
  } else {
    console.info("No matching rows found for update.");
  }
});

