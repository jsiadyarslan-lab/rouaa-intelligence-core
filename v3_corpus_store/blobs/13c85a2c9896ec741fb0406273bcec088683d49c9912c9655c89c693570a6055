    truncateArticlContent('.fw-normal');
});

function renderMonths() {

    
    const monthDropdown = document.getElementById("monthDropdown");

    arabicMonths.forEach((month, index) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.className = "dropdown-item";
        a.setAttribute("data-value", index + 1); // Month number (1-12)
        a.textContent = month;

        // Add event listener
        a.addEventListener("click", function () {
            selectedMonth = this.getAttribute("data-value");
            applySearch();
        });

        li.appendChild(a);
        monthDropdown.appendChild(li);
        
           
        const tagSelectMonth=document.getElementById('aSelectMonth');
        tagSelectMonth.addEventListener("click", function () {
            selectedMonth = "";
            applySearch();

        });

    });

}
function renderInput() {
    var inpt = document.getElementById('inptKeyword');
    
    inpt.addEventListener('change', function () {
        selectedText = this.value.trim();
        applySearch();
    });
}
function renderYears() {
    const startYear = 2003;
    const currentYear = new Date().getFullYear();
    const dropdown = document.getElementById("yearDropdown");

    for (let year = currentYear; year >= startYear; year--) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.className = "dropdown-item";
        a.setAttribute("data-value", year);
        a.textContent = year;

        // Add event listener
        a.addEventListener("click", function () {
            selectedYear = this.getAttribute("data-value");
            applySearch();

        });
        li.appendChild(a);
        dropdown.appendChild(li);
        
        const tagSelectYear=document.getElementById('aSelectYear');
        tagSelectYear.addEventListener("click", function () {
            selectedYear = "";
            applySearch();

        });
        
    }
}


function applySearch() {
    let keyword = $("#inptKeyword").val();
    var idx = 0
    var query = "";
    if(selectedMonth!=""&&selectedYear==""){
    idx++
        query+=`&FilterField${idx}=Month&FilterValue${idx}=${selectedMonth}`;
    }
    if(selectedMonth==""&&selectedYear!=""){
        idx++
        query+=`&FilterField${idx}=ArticleStartDate&FilterValue${idx}=${selectedYear}-01-01&FilterOp${idx}=Geq`;
        idx++;
        query+=`&FilterField${idx}=ArticleStartDate1&FilterValue${idx}=${selectedYear}-12-31&FilterOp${idx}=Leq`;
    }
