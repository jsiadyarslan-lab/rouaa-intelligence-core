  function processUrl(url) {
    if (!url) return { href: "#", external: false };

    const internalPattern = new RegExp("^https?://" + INTERNAL_HOST.replace(/\./g, "\\."), "i");
    if (internalPattern.test(url)) {
      const relative = url.replace(internalPattern, "") || "/";
      return { href: relative, external: false };
    }

    if (/^https?:\/\//i.test(url)) {
      return { href: url, external: true };
    }

    return { href: url, external: false };
  }

   
  function buildDropdownLink(link) {
