                $('#surveyModal').modal('hide');
            });
            $(".btn-never_show").click(function () {
                localStorage.setItem('displayPopup', '0');
                $('#surveyModal').modal('hide');
            });
            $(".btn-remind-later").click(function () {
                localStorage.setItem('displayPopup', '0');
                $('#surveyModal').modal('hide');
                var gun = new Date();
                gun.setDate(gun.getDate() + 1);
                localStorage.setItem('expireDate', gun);
