    <script>
    function preventSQLInjection(inputElement) {
        var value = inputElement.value;
        var regex = /^[a-zA-Z0-9\u0600-\u06FF@#$%^&*()\-+\[\]{}|\\:;",.\/? ]*$/;
        if (!regex.test(value)) {
            inputElement.value = value.replace(/[^\u0600-\u06FFa-zA-Z0-9@#$%^&*()\-+\[\]{}|\\:;",.\/? ]/g, '');
            alert("Input contains disallowed characters. Please only use alphanumeric characters, common symbols, and Arabic characters.");
        }
    }

    function attachEventListeners() {
        var textboxes = document.querySelectorAll("input[type='text']");
        textboxes.forEach(function(textbox) {
            textbox.addEventListener("input", function() {
                preventSQLInjection(textbox);
            });
        });
    }

    // Check if script has already been initialized
    var scriptInitialized = false;

    document.addEventListener("DOMContentLoaded", function() {
        if (!scriptInitialized) {
            attachEventListeners();
            scriptInitialized = true;
        }
    });
</script>

