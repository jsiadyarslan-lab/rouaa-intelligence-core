	<script language="javascript">
		
	function isValidDate(date){
  		if (date == "" || date == null) {
			flag = true;
			return flag;
		}
		var lang = "BG";
  		var datePattern = new RegExp(/^\d{2}\.\d{2}\.\d{4}$/);
	
	 	var flag = true;
  		if (datePattern.test(date)){
  			
  			day = date.split(".")[0];
  			month = date.split(".")[1];
  			year = date.split(".")[2];
	
  			var tempDate = new Date(year,month-1,day);
  			
  			flag = ((day == tempDate.getDate()) && (month-1 == tempDate.getMonth()) && (year == tempDate.getFullYear())  );
  			
  		}else {
  			flag = false;
  		}
  		if (!flag){
			<!--alert('Невалиден период');//-->
  		}
  		return flag;
  	}
  	
  	function isCorrectInterval(dateFrom,dateTo){
  		var result = true;
		if ((dateFrom == "" || dateFrom == null) || (dateTo == "" || dateTo == null)) {
			return true;
		}
		
		var date1 = new Date(dateFrom.split(".")[2], dateFrom.split(".")[1] - 1, dateFrom.split(".")[0]);
		var date2 = new Date(dateTo.split(".")[2], dateTo.split(".")[1] - 1, dateTo.split(".")[0]);

		if (date1 > date2){
			return false;
		}
		
		var days = (date2-date1)/(86400000);
		if (days > 365){
			return false;
		}
		
		return result;
	}
		
	function show_results(){
  		var datefrom = document.getElementById("fromDate").value;
  		<!-- alert(datefrom); -->
  		var dateto = document.getElementById("toDate").value;
  				
		var current = "/AboutUs/PressOffice/POCalendar/index.htm";
		var new_location = current + "?searchBy=1";	
		var flag = true;
		
		if(isValidDate(datefrom) && isValidDate(dateto)){
			if (isCorrectInterval(datefrom, dateto)){				
				document.getElementById("label_date").innerHTML = "&nbsp;";
				flag = true;
			}else{
				document.getElementById("label_date").innerHTML = "<b>" + 'Невалиден период' + "</b><br /><br />";
				flag = false;
			}
		}else{
			document.getElementById("label_date").innerHTML = "<b>" + 'Невалидна дата' + "</b><br /><br />";
			 flag = false;
		}
		
		if (datefrom != "" && datefrom != null){
			new_location = new_location + "&datefrom=" + datefrom;
		}
		if (dateto != "" && dateto != null){
			new_location = new_location + "&dateto=" + dateto;
		}
		  		
		var rubric = document.getElementById("rubric").value;
		if ("---" != rubric){
			new_location = new_location + "&r=" + rubric;
		}
		
		var page = document.getElementById("page").value;
		if (page != ""){
			new_location = new_location + "&page=" + page;
		}
		<!-- alert(new_location);  //-->
		
		if (flag){
			window.location.href = new_location;
		}
		
	}
	
	function loadPage(rubric){
		var calendar_page = "/bnbweb/groups/jsp/documents/bnb_jsp_page/po_calendar_page_jsp.jsp?r=" + rubric + "&lang=" + 0;
		loadDoc(calendar_page, "search_page");
	}
	
	function loadDownload(){
		var search = '0';
		
		if ("0" == search) {
			window.location.href='?download=pdf';
		} else {
			window.location.href=location.href + '&download=pdf';
		}
	}
	
	function loadDoc(pagePath, pagePlaceId) {
		var xmlhttp;
		if (window.XMLHttpRequest) {// code for IE7+, Firefox, Chrome, Opera, Safari
		  xmlhttp=new XMLHttpRequest();
		} else {// code for IE6, IE5
		  xmlhttp=new ActiveXObject("Microsoft.XMLHTTP");
		}
		xmlhttp.onreadystatechange=function() {
		  if (xmlhttp.readyState==4 && xmlhttp.status==200) {
			document.getElementById(pagePlaceId).innerHTML=xmlhttp.responseText;
		  }
		}		
		xmlhttp.open("GET", pagePath, true);			
		xmlhttp.send();
	}
	
	function clear_form_elements(ele, def_rubric) {
		
		document.getElementById("label_date").innerHTML = "&nbsp;";
		
        $(ele).find(':input').each(function() {
            switch(this.type) {
                case 'select-one':
					if ($(this)[0].id == 'rubric') {
						$(this).val(def_rubric);
						loadPage(def_rubric);
						break;
					} 					
                case 'text':
                    $(this).val('');
                    break;
                case 'radio':
                    this.checked = false;
            }
        });

    }

	function splitParams() {
		var params = {};

		if (location.search) {
			var parts = location.search.substring(1).split('&');

			for (var i = 0; i < parts.length; i++) {
				var nv = parts[i].split('=');
				if (!nv[0]) continue;
				params[nv[0]] = nv[1] || true;
			}
		}

		return params;
	}
	
	function checkDates (){
		var params = splitParams();
		if (params != null){
			var datefrom = params.datefrom;			
			var dateto = params.dateto;			
			
			var flag = true;
			if(isValidDate(datefrom) && isValidDate(dateto)){
				if (isCorrectInterval(datefrom, dateto)){						
					document.getElementById("label_date").innerHTML = "&nbsp;";
					flag = true;
				}else{
					document.getElementById("label_date").innerHTML = "<b>" + 'Невалиден период' + "</b><br /><br />";
					flag = false;
				}
			}else{
				document.getElementById("label_date").innerHTML = "<b>" + 'Невалидна дата' + "</b><br /><br />";
				 flag = false;
			}
		}		
	}
		
