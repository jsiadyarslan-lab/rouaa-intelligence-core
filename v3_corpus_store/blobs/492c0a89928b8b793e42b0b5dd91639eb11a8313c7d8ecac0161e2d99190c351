/* Hero Banner avec l'image officielle en arrière-plan */
.page-presentation-du-rapport-annuel .hero-banner {
    background:
        linear-gradient(rgba(252, 210, 133, 0.85), rgba(76, 46, 32, 0.90)),
        url('https://www.bceao.int/sites/default/files/2018-06/banniere%20web%20dsg%201.jpg')
        center/cover no-repeat;
    color: var(--blanc);
    padding: 60px 40px;
    max-width: 1920px;
    margin: 0 auto;
}

/* Layout interne de la bannière ajusté pour inverser les colonnes */
.page-presentation-du-rapport-annuel .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.page-presentation-du-rapport-annuel .hero-content {
    flex: 1;
    text-align: left;
}

.page-presentation-du-rapport-annuel .hero-banner h1 {
    font-size: 42px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    font-weight: 700;
    line-height: 1.2;
    color: #ffeec7;
}

.page-presentation-du-rapport-annuel .hero-banner p {
    font-size: 19px;
    color: #E2D7D2;
    margin-bottom: 35px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

/* Conteneur de la Vignette du Rapport */
.page-presentation-du-rapport-annuel .hero-vignette-wrapper {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-left: 20px;
}

.page-presentation-du-rapport-annuel .vignette-image {
    height: 280px;
    width: auto;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.3s;
}

/*
.page-presentation-du-rapport-annuel .vignette-image:hover {
    transform: scale(1.03);
}
*/

.page-presentation-du-rapport-annuel .btn-download {
    background-color: var(--blanc);
    color: var(--marron-brun);
    padding: 15px 40px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.25);
    letter-spacing: 0.5px;
}

.page-presentation-du-rapport-annuel .btn-download:hover {
    background-color: var(--jaune-ocre);
    color: var(--blanc);
}
/* ==========================================================
   CONTENU PRINCIPAL
   ========================================================== */

.page-presentation-du-rapport-annuel .container {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
}

.page-presentation-du-rapport-annuel .section-title {
    text-align: center;
    color: var(--marron-brun);
    font-size: 26px;
    text-transform: uppercase;
    margin-bottom: 40px;
    letter-spacing: 1px;
    position: relative;
    padding-bottom: 12px;
    font-weight: 700;
}

.page-presentation-du-rapport-annuel .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background-color: var(--jaune-ocre);
}

/* ==========================================================
   GRID DE CHIFFRES
   ========================================================== */

.page-presentation-du-rapport-annuel .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 70px;
}

.page-presentation-du-rapport-annuel .stat-card {
    background: var(--marron-brun);
    color: var(--blanc);
    padding: 35px 25px;
    border-radius: 6px;
    text-align: center;
    border-bottom: 6px solid var(--jaune-ocre);
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 15px rgba(76, 46, 32, 0.1);
}

.page-presentation-du-rapport-annuel .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(76, 46, 32, 0.2);
}

.page-presentation-du-rapport-annuel .stat-label {
    font-size: 16px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #D2C4BE;
    letter-spacing: 0.8px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
}

.page-presentation-du-rapport-annuel .stat-value {
    font-size: 52px;
    font-weight: 800;
    color: var(--jaune-ocre);
    margin: 15px 0 5px 0;
    line-height: 0.8;
}
.page-presentation-du-rapport-annuel .stat-value span {
    font-size: 40px;
    color: #cd9f7c;
}

/* Deuxième ligne de chiffres */

.page-presentation-du-rapport-annuel .stats-secondary {
    grid-template-columns: repeat(2, 1fr);
}

/* ==========================================================
   RESSOURCES & TÉLÉCHARGEMENTS
   ========================================================== */

.page-presentation-du-rapport-annuel .resources-list {
    background: var(--blanc);
    border-radius: 8px;
    padding: 35px;
    box-shadow: 0 4px 25px rgba(76, 46, 32, 0.06);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.page-presentation-du-rapport-annuel .resource-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border: 1px solid #EAE5E2;
    border-radius: 6px;
    text-decoration: none;
    color: var(--texte-sombre);
    transition: all 0.2s;
    font-size: 16px;
    text-transform: uppercase;
}

.page-presentation-du-rapport-annuel .resource-item:hover {
    border-color: var(--jaune-ocre);
    background: rgba(241, 136, 55, 0.04);
    transform: scale(1.01);
}

.page-presentation-du-rapport-annuel .file-icon {
    font-size: 28px;
    color: #C1392B;
    font-weight: bold;
}
.page-presentation-du-rapport-annuel .resource-item {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
}

.page-presentation-du-rapport-annuel .resource-content {
    display: flex;
    flex-direction: column;
}

.page-presentation-du-rapport-annuel .resource-desc {
    font-size: 13px;
    color: #7F8C8D;
    margin-top: 2px;
}
