<figure class="img-container body-img">
         <picture>
                  <source srcset="/sites/default/files/styles/news_detail_843_421/public/2026-07/VDP_6946.jpg.webp?itok=GyOlt4Vk 1x" media=" 992px)" type="image/webp" width="843" height="421" />
              <source srcset="/sites/default/files/styles/news_detail_ipad/public/2026-07/VDP_6946.jpg.webp?itok=pP-PKz9J 1x" media=" 768px)" type="image/webp" width="720" height="360" />
              <source srcset="/sites/default/files/styles/news_detail_mobile/public/2026-07/VDP_6946.jpg.webp?itok=XRh2LVov 1x" media=" 576px)" type="image/webp" width="343" height="171" />
                  <img loading="lazy" width="843" height="421" src="/sites/default/files/styles/news_detail_fallback/public/2026-07/VDP_6946.jpg?itok=Q8zm6ZsQ" alt="ICAO statement on proposed expanded scope of EU Emission Trading System" title="ICAO statement on proposed expanded scope of EU Emission Trading System" class="img-fluid" />

