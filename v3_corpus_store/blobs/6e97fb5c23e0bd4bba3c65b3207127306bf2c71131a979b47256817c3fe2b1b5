	<div class="lfr-layout-structure-item-8e9be112-0482-6ba4-c8ef-1a44fef5fd42 lfr-layout-structure-item-container "><div class="lfr-layout-structure-item-a899c054-5439-2922-1018-33616101b21f lfr-layout-structure-item-container  container-fluid container-fluid-max-xl"><div class="lfr-layout-structure-item-d023c6e6-208f-7a64-b06f-f90f8a3178e0 lfr-layout-structure-item-row "><div class="row align-items-lg-start align-items-sm-start align-items-start align-items-md-start flex-lg-row flex-sm-row flex-row flex-md-row"><div class="col col-lg-12 col-sm-12 col-12 col-md-12"><div class="lfr-layout-structure-item-image-header lfr-layout-structure-item-ecfeadf2-c4db-2b6c-990b-e0fe1cc8713a "><div id="fragment-2bf42b68-404d-68e4-dc1b-988dec753542" >
<div class="featured-image">
        <div class="ecl-row ecl-u-d-flex justify-content-center ecl-u-mv-l">
          <div class="ecl-col-12 ecl-col-l-9">
            <div class="position-relative">
              <img src="https://ec.europa.eu/eurostat/documents/4187653/15727800/maykal_AdobeStock_511151036_RV.jpg/ab49e130-71e1-f4fc-7a8c-d61f3713efde?version=1.0&amp;t=1683732451354" alt="Smoke from chmineys.">
