 <style>
/* ===== SharePoint Breadcrumb Styling - RTL ===== */

/* الحاوية الرئيسية للـ breadcrumb */
.ms-breadcrumb {
    display: inline-block;
    padding: 0;
    margin: 0;
    background: transparent;
   /* font-family: 'Segoe UI', Tahoma, Arial, sans-serif;*/
    font-size: 14px;
    direction: rtl;
    line-height: 1.5;
}

/* تنسيق الجدول الداخلي */
.ms-breadcrumb table {
    display: inline-block;
    border-collapse: collapse;
    border-spacing: 0;
    margin: 0;
    padding: 0;
    background: transparent;
}

.ms-breadcrumb tbody,
.ms-breadcrumb tr {
    display: inline-block;
}

.ms-breadcrumb td {
    display: inline-block !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    background: transparent !important;
    vertical-align: middle;
}

/* عناصر الـ breadcrumb العادية */
.ms-breadcrumbNode,
.ms-breadcrumbNode a {
    display: inline;
    color: #666666 !important;
    text-decoration: none !important;
    transition: color 0.2s ease;
    padding: 0;
    margin: 0;
    background: transparent !important;
    border: none !important;
}

.ms-breadcrumbNode:hover,
.ms-breadcrumbNode a:hover {
    /*color: #0066cc !important;*/
    text-decoration: none !important;
    background: transparent !important;
}

/* العنصر النشط (الصفحة الحالية) */
.ms-breadcrumbCurrentNode {
    display: inline;
    color: #9DA4AE !important;
    font-weight: normal;
    padding: 0;
    margin: 0;
    background: transparent !important;
    text-decoration: none !important;
}

/* العنصر الجذر */
.ms-breadcrumbRootNode,
.ms-breadcrumbRootNode a {
    display: inline;
    color: #384250 !important;
    text-decoration: none !important;
    padding: 0;
    margin: 0;
    background: transparent !important;
}

.ms-breadcrumbRootNode:hover,
.ms-breadcrumbRootNode a:hover {
   /* color: #0066cc !important;*/
    text-decoration: none !important;
    background: transparent !important;
}

/* إضافة الفاصل ‹ بين العناصر */
.ms-breadcrumb td + td::before {
    content: " ‹ ";
    color: #cccccc;
    margin: 0 5px;
    font-size: 14px;
    display: inline-block;
}

/* إخفاء الصور */
.ms-breadcrumb img {
    display: none !important;
}

/* إزالة أي خلفيات عند focus */
.ms-breadcrumb *:focus {
    background: transparent !important;
    outline: none;
}

.ms-breadcrumb * {
    box-sizing: border-box;
}

/* ===== Responsive Design ===== */
@media (max-width: 768px) {
    .ms-breadcrumb {
        font-size: 12px;
    }
    
    .ms-breadcrumb td + td::before {
        margin: 0 4px;
        font-size: 13px;
    }
}

@media (max-width: 480px) {
    .ms-breadcrumb {
        font-size: 11px;
    }
    
    .ms-breadcrumb td + td::before {
        margin: 0 3px;
        font-size: 12px;
    }
}

