  function renderHeaderMenu(items) {
    const target = document.getElementById("masterPageHeader");
    if (!target) {
      console.error("Element #masterPageHeader not found");
      return;
    }

   
    const existingNav = target.querySelector(".top_nav");
    if (existingNav) {
      existingNav.remove();
    }

    
    const nav = document.createElement("nav");
    nav.className = "container-fluid top_nav";

     
    nav.appendChild(buildBrandSection());

    
    const ul = document.createElement("ul");
    ul.className = "navbar-nav xxxl-nav d-none d-xxxl-flex w-100";

   
    ul.appendChild(buildMobileHeader());
    ul.appendChild(buildMobileHomeLink());

  
    (items || []).forEach(function (item) {
      const columns = item.Columns || [];

      if (columns.length >= 1) {
        ul.appendChild(buildMegaMenuItem(item));
      } else {
        ul.appendChild(buildPlainNavItem(item));
      }
    });

    
    ul.appendChild(buildMobileSearchButton());
    ul.appendChild(buildMobileLangButton());

    nav.appendChild(ul);

     
    nav.appendChild(buildLanguageNav());

    target.appendChild(nav);

    
    setupMobileToggler(nav);
  }

  
  function setupMobileToggler(navContainer) {
    if (!navContainer) return;

    const toggler = navContainer.querySelector(".navbar-toggler");
    const closer = navContainer.querySelector(".navbar-close");
    const menu = navContainer.querySelector(".navbar-nav.xxxl-nav");

    if (!toggler || !menu) return;

    function openMenu() {
      menu.classList.add("show", "open");
      document.body.classList.add("menu-open", "nav-open");
    }

    function closeMenu() {
      menu.classList.remove("show", "open");
      document.body.classList.remove("menu-open", "nav-open");
    }

    function toggleMenu(e) {
      e.preventDefault();
      e.stopPropagation();
      if (menu.classList.contains("show")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggler.addEventListener("click", toggleMenu);

    if (closer) {
      closer.addEventListener("click", function (e) {
        e.preventDefault();
        closeMenu();
      });
    }

   
    menu.querySelectorAll(".dropdown-toggle").forEach(function (toggle) {
    
      toggle.addEventListener("click", function (e) {
        
        const isMobile = window.getComputedStyle(toggler).display !== "none";
        if (!isMobile) return;

        
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const parentLi = toggle.closest(".nav-item.dropdown");
        if (!parentLi) return;

        const submenu = parentLi.querySelector(".dropdown-menu");
        const isOpen = parentLi.classList.contains("show");

       
        menu.querySelectorAll(".nav-item.dropdown.show").forEach(function (li) {
          if (li !== parentLi) {
            li.classList.remove("show", "open", "active");
            const sub = li.querySelector(".dropdown-menu");
            if (sub) {
              sub.classList.remove("show", "open");
              toggle.setAttribute("aria-expanded", "false");
            }
          }
        });

       
        if (isOpen) {
          parentLi.classList.remove("show", "open", "active");
          if (submenu) submenu.classList.remove("show", "open");
          toggle.setAttribute("aria-expanded", "false");
        } else {
          parentLi.classList.add("show", "open", "active");
          if (submenu) submenu.classList.add("show", "open");
          toggle.setAttribute("aria-expanded", "true");
        }
      }, true); 
    });

    
    menu.querySelectorAll("a.nav-link:not(.dropdown-toggle), a.dropdown-item").forEach(function (link) {
      link.addEventListener("click", function () {
        if (window.getComputedStyle(toggler).display !== "none") {
          closeMenu();
        }
      });
    });

  
    document.addEventListener("click", function (e) {
      if (!menu.classList.contains("show")) return;
      if (navContainer.contains(e.target)) return; 
      closeMenu();
    });
  }

  
  function loadHeaderMenu() {
    fetch(HANDLER_URL, { credentials: "same-origin" })
      .then(function (response) {
        if (!response.ok) {
          throw new Error("HTTP " + response.status);
        }
        return response.json();
      })
      .then(function (data) {
        //console.log("Header Data:", data);
        const items = Array.isArray(data) ? data : (data.d || data.results || data.items || []);
        renderHeaderMenu(items);
      })
      .catch(function (err) {
        console.error("Header menu error:", err);
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadHeaderMenu);
  } else {
    loadHeaderMenu();
  }
})();

 
