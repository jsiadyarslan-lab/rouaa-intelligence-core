      const popoverInstance = ECL.components.get(shareButton.parentElement);
      popoverInstance.closePopover();
      shareButton.focus();
    }

    // navigate within popover items using arrow keys
    const currentIndex = popoverItems.indexOf(document.activeElement);
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const nextIndex = currentIndex === -1 ? 0 : (currentIndex + 1) % popoverItems.length;
      popoverItems[nextIndex].focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prevIndex = currentIndex === -1 ? popoverItems.length - 1 : (currentIndex - 1 + popoverItems.length) % popoverItems.length;
      popoverItems[prevIndex].focus();
    }
  });
