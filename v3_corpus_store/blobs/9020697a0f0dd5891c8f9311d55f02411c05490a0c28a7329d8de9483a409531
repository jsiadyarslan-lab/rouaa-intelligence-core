function handleAccessibilityFocus() {
  const shareButton = fragmentElement.querySelector('.ecl-popover > button');
  const popover = shareButton.nextElementSibling;
  const popoverItems = Array.from(popover.querySelectorAll('.ecl-popover__item > button'));

  // handle click on share button (focus on first popover item)
  shareButton.addEventListener('click', () => {
    popoverItems[0].focus();
  });
  
  // handle keyboard navigation when popover is open
  document.addEventListener('keydown', (e) => {
    const isOpen = shareButton.getAttribute('aria-expanded') === 'true';
    if (!isOpen) return;

    // handle esc or tab to return focus to share button
    if (e.key === 'Escape') {
      shareButton.focus();
    }
    if (e.key === 'Tab') {
      e.preventDefault();
      const popoverInstance = ECL.components.get(shareButton.parentElement);
      popoverInstance.closePopover();
      shareButton.focus();
    }

    // navigate within popover items using arrow keys
    const currentIndex = popoverItems.indexOf(document.activeElement);
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const nextIndex = currentIndex === -1 ? 0 : (currentIndex + 1) % popoverItems.length;
      popoverItems[nextIndex].focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prevIndex = currentIndex === -1 ? popoverItems.length - 1 : (currentIndex - 1 + popoverItems.length) % popoverItems.length;
      popoverItems[prevIndex].focus();
    }
  });
