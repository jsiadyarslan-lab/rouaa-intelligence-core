function handleAccessibilityFocus() {
  const shareButton = fragmentElement.querySelector('.ecl-popover > button');
  const popover = shareButton.nextElementSibling;
  const popoverItems = Array.from(popover.querySelectorAll('.ecl-popover__item > button'));

  // handle click on share button (focus on first popover item)
  shareButton.addEventListener('click', () => {
    popoverItems[0].focus();
  });
  
  // handle keyboard navigation when popover is open
  document.addEventListener('keydown', (e) => {
    const isOpen = shareButton.getAttribute('aria-expanded') === 'true';
    if (!isOpen) return;

    // handle esc or tab to return focus to share button
    if (e.key === 'Escape') {
      shareButton.focus();
