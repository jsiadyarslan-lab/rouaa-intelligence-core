    <script>
        (function () {

    const blockedChars = /[<>!=]/g;

    function sanitizeInput(e) {
        if (e.target.tagName.toLowerCase() === "input" ||
            e.target.tagName.toLowerCase() === "textarea") {

            if (blockedChars.test(e.target.value)) {
                e.target.value = e.target.value.replace(blockedChars, "");
            }
        }
    }

    function preventKeystroke(e) {
        if (["<", ">", "!", "="].includes(e.key)) {
            e.preventDefault();
        }
    }

    // Block typing
    document.addEventListener("keydown", preventKeystroke);

    // Block paste, drag-drop, autofill
    document.addEventListener("input", sanitizeInput);

})();

    </script>
