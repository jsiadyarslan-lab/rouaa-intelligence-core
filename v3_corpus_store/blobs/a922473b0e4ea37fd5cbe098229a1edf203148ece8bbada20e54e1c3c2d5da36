			if (b == 'print') {
				b = print;
			}
			if (b == 'pdf') {
				b = pdf;
			}
			buttons.push(b);
		}
    } else {
    	buttons = ['copy', 'csv', excel, pdf, print];
    }

	el.dataTable({
