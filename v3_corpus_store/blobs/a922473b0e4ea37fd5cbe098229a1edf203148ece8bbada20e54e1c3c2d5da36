<script>
$.fn.dataTable.ext.errMode = 'throw';
function attachDatatable(el, pButtons)
{
	var pdf = {
        extend: 'pdfHtml5',
        text: 'PDF',
        title: '',
        orientation: 'landscape',
        pageSize: 'A3',
	};

	const superscriptMap = {
	  '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴',
	  '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹'
	};

	const subscriptMap = {
	  '0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄',
	  '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉'
	};

	function replaceNumbersWithSuperSub(text) {
	  // Replace <sup>...</sup> digits with superscript digits, keep other chars as-is
	  text = text.replace(/<sup>(.*?)<\/sup>/g, (_, content) =>
	    content.split('').map(c => superscriptMap[c] || c).join('')
	  );

	  // Replace <sub>...</sub> digits with subscript digits, keep other chars as-is
	  text = text.replace(/<sub>(.*?)<\/sub>/g, (_, content) =>
	    content.split('').map(c => subscriptMap[c] || c).join('')
	  );

	  return text;
	}

	var captionEl = el.find('caption');
	var captionElLength = captionEl.length;

	if (captionElLength) {
		var caption = replaceNumbersWithSuperSub(captionEl.html());
		//caption = $.fn.DataTable.Buttons.stripData(caption, null);
		captionEl.html(caption);
	}

	var excel = {
		extend: 'excelHtml5',
        text: 'Excel',
        title: '',
        exportOptions: {
            format: {
           	 	header: function (data, rowIdx, colIdx, node) {
               	 	var data2 = replaceNumbersWithSuperSub(data);
                  	data2 = data2.replace(/<br\s*\/?>/ig, "\n");
                  	data2 = $.fn.DataTable.Buttons.stripData(data2, null);
                	return data2;
				},
                footer: function (data, rowIdx, colIdx, node) {
                	var data2 = replaceNumbersWithSuperSub(data);
                	data2 = data2.replace(/<br\s*\/?>/ig, '\n');
                	data2 = $.fn.DataTable.Buttons.stripData(data2, null);
                	return data2;
                },
                body: function (data, row, column, node) {
                    var data2 = replaceNumbersWithSuperSub(data);
                    data2 = data2.replace(/<br\s*\/?>/ig, '\n');
                    data2 = $.fn.DataTable.Buttons.stripData(data2, null);
                	var sanitizedValue = data2.replace(/\s+/g, '');
                	if ($.isNumeric(sanitizedValue)) {
						return sanitizedValue;
                	}
                    return data2;
                }
            }
        },
        customize: function(xlsx) {
            var sheet = xlsx.xl.worksheets['sheet1.xml'];

            // Add a custom number format for 1 decimal place
            var styles = xlsx.xl['styles.xml'];
            var numFmts = $('numFmts', styles);
            if (!numFmts.length) {
                numFmts = $('<numFmts count="1"/>');
                $('styleSheet', styles).prepend(numFmts);
            }
            var fmtId = 164;
            numFmts.append('<numFmt numFmtId="' + fmtId + '" formatCode="0.0"/>');
            numFmts.attr('count', numFmts.find('numFmt').length);

            // Add a cell style that uses this number format
            var cellXfs = $('cellXfs', styles);
            var newXf = '<xf numFmtId="' + fmtId + '" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>';
            cellXfs.append(newXf);
            var oneDecimalStyleIdx = cellXfs.find('xf').length - 1;

            // Add a cell style for left alignment
            var leftAlignXf = '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1"><alignment horizontal="left"/></xf>';
            cellXfs.append(leftAlignXf);
            var leftAlignStyleIdx = cellXfs.find('xf').length - 1;
            cellXfs.attr('count', cellXfs.find('xf').length);

            $('row', sheet).each(function (rIndex) {
                if (!captionElLength || rIndex > 2) {
                    $('c', this).each(function (cIndex) {
                    	var td = el.find('tr').eq(rIndex - (captionElLength ? 1 : 0)).find('td').eq(cIndex);
                    	if (td.hasClass('bold') || td.hasClass('boldt')) {
                    		$(this).attr('s', '2');
                    	}
                    	var cellValue = $(this).text();
                    	if (cellValue === 'NaN' || cellValue === '.' || cellValue === ',' || cellValue === '-' || cellValue === 'х' || cellValue === 'x') {
                    		$(this).attr('s', '52');
                        }
                        // Apply 1 decimal format to cells whose original text had .0
                        var originalText = td.text().replace(/\s+/g, '').replace(/,/g, '.');
                        if (originalText.match(/^\-?\d+\.0$/)) {
                            $(this).attr('s', oneDecimalStyleIdx);
                        }
                        // Apply left alignment for cells with class left_top
                        if (td.hasClass('left_top')) {
                            $(this).attr('s', leftAlignStyleIdx);
                        }
                    });
                }
            });
            var totalRows = $(sheet).find('row').length;
            var thHeadRowCount = el.find('thead tr').length;
            var thFootRowCount = el.find('tfoot tr').length;
            var footerStartRow = totalRows - thFootRowCount + 1;
            for (var i = footerStartRow; i <= totalRows; i++) {
                $(sheet).find('row[r="' + i + '"] c').each(function () {
                	$(this).removeAttr('s');
                });
            }
        }
	};

	var print = {
        extend: 'print',
        title: '',
    };

    var buttons = [];

    if ($.isArray(pButtons)) {
		for(var i = 0; i < pButtons.length; ++i) {
			var b = pButtons[i];
			if (b == 'excel') {
				b = excel;
