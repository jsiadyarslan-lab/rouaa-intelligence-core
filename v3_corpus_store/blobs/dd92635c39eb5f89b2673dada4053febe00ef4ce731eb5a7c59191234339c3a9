                        $(this).attr('id', 'notification_' + i);
                    });

                    notification.filter('.closeable').append(closeBtn);

                    closeButton = notification.find('> .close');

                    closeButton.click(function() {
                        hideIt($(this).parent());
                        return false;
                    });

                    function hideIt(object) {
                        switch (options.animation) {
                            case 'fade':
                                fadeIt(object);
                                break;
                            case 'slide':
                                slideIt(object);
                                break;
                            case 'box':
                                boxAnimIt(object);
