function truncateMultibyteText(text, maxLength) {
	  // Convert the text into an array of characters to handle multibyte characters
	  const textArray = Array.from(text);
	  // Check if the text exceeds the max length
	  if (textArray.length > maxLength) {
	    // Truncate the text and append '...'
	    return textArray.slice(0, maxLength).join('') + '...';
	  }
	  // If the text is within the limit, return it as is
	  return text;
}
